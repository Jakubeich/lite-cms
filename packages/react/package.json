{
  "name": "@litecms/react",
  "version": "0.1.0",
  "description": "React components for LiteCMS inline editing",
  "author": "Jakub Mitrega <jakubmitrega1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/jakubeich/litecms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubeich/litecms.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jakubeich/litecms/issues"
  },
  "keywords": [
    "cms",
    "litecms",
    "inline-editing",
    "react",
    "contenteditable",
    "nextjs",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@litecms/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
